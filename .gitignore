# credentials
git/.config/git/credentials

# gtk user preferences
gtk/.config/gtk-2.0/gtkfilechooser.ini
gtk/.config/gtk-3.0/bookmarks

# media player cache
mopidy/.config/mopidy/podcast

# neovim generated files
neovim/.config/nvim/lua/packer_compiled.lua
neovim/.config/nvim/.netrwhist

# file manager preferences
thunar/.config/Thunar/accels.scm
thunar/.config/Thunar/renamerrc

# zsh compiled files
*.zwc
zsh/.config/zsh/.zcompdump

# icon caches
gtk/.local/share/icons/**/*.cache

# dynamic theme file generated by tinted-terminal
kitty/.config/kitty/theme.conf

# dynamic status bar generated from scripts
tmux/.config/tmux/statusbar.conf

# theme name cache for tinty
tinty/.config/tinted-theming/theme_name

# python cache files
*.pyc
__pycache__/

# uv script cache
.cache/

# macOS finder metadata
.DS_Store

# serena session state
.serena/

# codanna index state
.codanna/

# ruff cache
.ruff_cache/

# font-manager file
fontconfig/.config/fontconfig/conf.d/09-Directories.conf

# beets state file
beets/.config/beets/state.pickle

# awesomewm external libs
awesome/.config/awesome/extlib

# sketchybar generated colors
sketchybar/.config/sketchybar/colors_generated.lua

# cava shaders and rendered themes
cava/.config/cava/shaders/
cava/.config/cava/themes/

