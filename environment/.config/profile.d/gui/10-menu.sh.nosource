#!/usr/bin/env sh

## common menu settings

# menu backend selection
if [ -n "$WAYLAND_DISPLAY" ]; then
    MENU_BACKEND="tofi"
elif [ -n "$DISPLAY" ]; then
    MENU_BACKEND="dmenu"
else
    MENU_BACKEND="fzf"
fi

# menu layout
# hide system bar while menu is active
MENU_OVERLAY="false"
# menu position: top, bottom, left, right, center
MENU_POSITION="top"
# number of columns in the menu (integer or 'auto' for dynamic)
MENU_LAYOUT_COLUMNS="auto"
# number of rows (integer or 'auto' for dynamic)
MENU_LAYOUT_ROWS="auto"

# menu geometry
# menu width as percent of screen
MENU_WIDTH="100"
# menu height as percent of screen
MENU_HEIGHT="25"
# menu line height in pixels
MENU_LINE_HEIGHT="$(qs ipc call bar getBarDimensions 2> /dev/null | head -1 | cut -d: -f4)"
[ -z "$MENU_LINE_HEIGHT" ] && MENU_LINE_HEIGHT="27"
# menu font
MENU_FONT="$(qs ipc call bar getBarFont 2> /dev/null)"
[ -z "$MENU_FONT" ] && MENU_FONT="sans"

# menu padding and borders
# horizontal padding (pixels)
MENU_PADDING_X="0"
# vertical padding (pixels)
MENU_PADDING_Y="0"
# border width (pixels)
MENU_BORDER_WIDTH="2"

# menu colors
# menu background color
MENU_COLOR_BG="#0a0a0a" # theme:managed
# menu text color
MENU_COLOR_FG="#7b7b7b" # theme:managed
# header background color
MENU_COLOR_HEADER_BG="#131313" # theme:managed
# header foreground color
MENU_COLOR_HEADER_FG="#7b7b7b" # theme:managed
# selected item background
MENU_COLOR_SELECTED_BG="#9ccbfb" # theme:managed
# selected item foreground
MENU_COLOR_SELECTED_FG="#0a0a0a" # theme:managed
# selected item fg (active)
MENU_COLOR_SELECTED_FG_ACTIVE="#808080" # theme:managed
# selected item fg (urgent)
MENU_COLOR_SELECTED_FG_URGENT="#ffb3b2" # theme:managed
# menu border color
MENU_COLOR_BORDER="#7f7f7f" # theme:managed
# menu separator color
MENU_COLOR_SEPARATOR="#7f7f7f" # theme:managed
