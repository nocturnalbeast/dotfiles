#![enable(implicit_some, unwrap_newtypes, unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: false,
    browser_column_widths: [
        20,
        38,
        42,
    ],
    background_color: "black",
    text_color: "#7b7b7b",
    header_background_color: "black",
    modal_background_color: "black",
    tab_bar: (
        enabled: true,
        active_style: (
            fg: "#0a0a0a",
            bg: "#7b7b7b",
            modifiers: "Bold",
        ),
        inactive_style: (
            fg: "#7b7b7b",
            bg: "black",
        ),
    ),
    highlighted_item_style: (
        fg: "#464646",
        modifiers: "Bold",
    ),
    current_item_style: (
        fg: "#0a0a0a",
        bg: "#9ccbfb",
        modifiers: "Bold",
    ),
    borders_style: (
        fg: "#808080",
    ),
    highlight_border_style: (
        fg: "#9ccbfb",
    ),
    symbols: (
        song: "S",
        dir: "D",
        marker: "M",
        ellipsis: "...",
    ),
    progress_bar: (
        symbols: [
            "█",
            "▌",
            " ",
        ],
        track_style: (
            fg: "#808080",
        ),
        elapsed_style: (
            fg: "#9ccbfb",
        ),
        thumb_style: (
            fg: "#9ccbfb",
        ),
    ),
    scrollbar: (
        symbols: [
            " ",
            "█",
            "▲",
            "▼",
        ],
        track_style: (
            fg: "#808080",
        ),
        ends_style: (
            fg: "#7f7f7f",
        ),
        thumb_style: (
            fg: "#9ccbfb",
        ),
    ),
    song_table_format: [
        (
            prop: (
                kind: Property(Artist),
                default: (
                    kind: Text("Unknown"),
                ),
            ),
            width: "20%",
        ),
        (
            prop: (
                kind: Property(Title),
                default: (
                    kind: Text("Unknown"),
                ),
            ),
            width: "35%",
        ),
        (
            prop: (
                kind: Property(Album),
                style: (
                    fg: "#7c7c7c",
                ),
                default: (
                    kind: Text("Unknown Album"),
                    style: (
                        fg: "#808080",
                    ),
                ),
            ),
            width: "30%",
        ),
        (
            prop: (
                kind: Property(Duration),
                default: (
                    kind: Text("-"),
                ),
            ),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "100%",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "30%",
                            borders: "ALL",
                            pane: Split(
                                direction: Vertical,
                                panes: [
                                    (
                                        size: "45%",
                                        pane: Pane(AlbumArt),
                                    ),
                                    (
                                        size: "25%",
                                        pane: Pane(Header),
                                    ),
                                    (
                                        size: "30%",
                                        pane: Pane(Lyrics),
                                    ),
                                ],
                            ),
                        ),
                        (
                            size: "70%",
                            borders: "ALL",
                            pane: Split(
                                direction: Vertical,
                                panes: [
                                    (
                                        size: "100%",
                                        pane: Pane(TabContent),
                                    ),
                                    (
                                        size: "1",
                                        borders: "NONE",
                                        pane: Pane(Tabs),
                                    ),
                                ],
                            ),
                        ),
                    ],
                ),
            ),
            (
                size: "3",
                borders: "ALL",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            pane: Pane(Property(
                                content: [
                                    (
                                        kind: Property(Status(StateV2(
                                            playing_label: "  ",
                                            paused_label: "  ",
                                            stopped_label: "  ",
                                        ))),
                                    ),
                                ],
                                align: Left,
                            )),
                            size: "4",
                        ),
                        (
                            size: "100%",
                            pane: Pane(ProgressBar),
                        ),
                        (
                            pane: Pane(Property(
                                content: [
                                    (
                                        kind: Property(Status(Elapsed)),
                                    ),
                                    (
                                        kind: Text(" / "),
                                    ),
                                    (
                                        kind: Property(Status(Duration)),
                                    ),
                                    (
                                        kind: Group([
                                            (
                                                kind: Text(" ("),
                                            ),
                                            (
                                                kind: Property(Status(Bitrate)),
                                            ),
                                            (
                                                kind: Text(" kbps)"),
                                            ),
                                        ]),
                                    ),
                                ],
                                align: Right,
                            )),
                            size: "24",
                        ),
                    ],
                ),
            ),
        ],
    ),
    header: (
        rows: [
            (
                left: [
                ],
                center: [
                ],
                right: [
                ],
            ),
            (
                left: [
                ],
                center: [
                    (
                        kind: Property(Song(Title)),
                        style: (
                            fg: "#80d4d4",
                            modifiers: "Bold",
                        ),
                        default: (
                            kind: Property(Song(Filename)),
                            style: (
                                fg: "#80d4d4",
                                modifiers: "Bold",
                            ),
                        ),
                    ),
                ],
                right: [
                ],
            ),
            (
                left: [
                ],
                center: [
                    (
                        kind: Property(Song(Artist)),
                        style: (
                            fg: "#7b7b7b",
                            modifiers: "Bold",
                        ),
                        default: (
                            kind: Text("Unknown Artist"),
                            style: (
                                fg: "#7b7b7b",
                                modifiers: "Bold",
                            ),
                        ),
                    ),
                ],
                right: [
                ],
            ),
            (
                left: [
                ],
                center: [
                    (
                        kind: Property(Song(Album)),
                        style: (
                            fg: "#dbb9f9",
                        ),
                        default: (
                            kind: Text("Unknown Album"),
                            style: (
                                fg: "#dbb9f9",
                                modifiers: "Bold",
                            ),
                        ),
                    ),
                ],
                right: [
                ],
            ),
            (
                left: [
                    (
                        kind: Text("[ "),
                        style: (
                            fg: "#dbb9f9",
                        ),
                    ),
                    (
                        kind: Property(Status(RepeatV2(
                            on_label: " ",
                            off_label: " ",
                            on_style: (
                                fg: "#7b7b7b",
                                modifiers: "Bold",
                            ),
                            off_style: (
                                fg: "#7f7f7f",
                                modifiers: "Bold",
                            ),
                        ))),
                    ),
                    (
                        kind: Text(" | "),
                        style: (
                            fg: "#dbb9f9",
                        ),
                    ),
                    (
                        kind: Property(Status(RandomV2(
                            on_label: " ",
                            off_label: " ",
                            on_style: (
                                fg: "#7b7b7b",
                                modifiers: "Bold",
                            ),
                            off_style: (
                                fg: "#7f7f7f",
                                modifiers: "Bold",
                            ),
                        ))),
                    ),
                    (
                        kind: Text(" | "),
                        style: (
                            fg: "#dbb9f9",
                        ),
                    ),
                ],
                center: [
                    (
                        kind: Text("󰕾 "),
                        style: (
                            fg: "#dbb9f9",
                            modifiers: "Bold",
                        ),
                    ),
                    (
                        kind: Property(Status(Volume)),
                        style: (
                            fg: "#7b7b7b",
                            modifiers: "Bold",
                        ),
                    ),
                    (
                        kind: Text("%"),
                        style: (
                            fg: "#dbb9f9",
                            modifiers: "Bold",
                        ),
                    ),
                ],
                right: [
                    (
                        kind: Text(" | "),
                        style: (
                            fg: "#dbb9f9",
                        ),
                    ),
                    (
                        kind: Property(Status(ConsumeV2(
                            on_label: "󰮯 ",
                            off_label: "󰮯 ",
                            oneshot_label: "󰮯 󰇊",
                            on_style: (
                                fg: "#7b7b7b",
                                modifiers: "Bold",
                            ),
                            off_style: (
                                fg: "#7f7f7f",
                                modifiers: "Bold",
                            ),
                        ))),
                    ),
                    (
                        kind: Text(" | "),
                        style: (
                            fg: "#dbb9f9",
                        ),
                    ),
                    (
                        kind: Property(Status(SingleV2(
                            on_label: "󰎤 ",
                            off_label: "󰎦 ",
                            oneshot_label: "󰇊 ",
                            off_oneshot_label: "󱅊 ",
                            on_style: (
                                fg: "#7b7b7b",
                                modifiers: "Bold",
                            ),
                            off_style: (
                                fg: "#7f7f7f",
                                modifiers: "Bold",
                            ),
                        ))),
                    ),
                    (
                        kind: Text(" ]"),
                        style: (
                            fg: "#dbb9f9",
                        ),
                    ),
                ],
            ),
        ],
    ),
    browser_song_format: [
        (
            kind: Group([
                (
                    kind: Property(Track),
                ),
                (
                    kind: Text(" "),
                ),
            ]),
        ),
        (
            kind: Group([
                (
                    kind: Property(Artist),
                ),
                (
                    kind: Text(" - "),
                ),
                (
                    kind: Property(Title),
                ),
            ]),
            default: (
                kind: Property(Filename),
            ),
        ),
    ],
)
