#!/usr/bin/env sh

# A script to control screen brightness using various backends (brightnessctl,
# ddcutil, xbacklight) with notifications. Supports both internal backlight
# devices and external monitors via DDC/CI.

# Global configuration
ICON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/notification_icons"
ICON_LOW="$ICON_DIR/brightness_low.svg"
ICON_MEDIUM="$ICON_DIR/brightness_medium.svg"
ICON_HIGH="$ICON_DIR/brightness_high.svg"

usage() {
    cat << EOF
Usage: $(basename "$0") OPERATION [VALUE]

A script to control screen brightness with notifications.
Supports brightnessctl (backlight devices), ddcutil (external monitors via
DDC/CI), and xbacklight as backends.

Operations:
    increase [step]  Increase brightness by step% (default: 5%)
    decrease [step]  Decrease brightness by step% (default: 5%)
    set <percent>    Set brightness to specific percentage (0-100)
    get              Get current brightness level

Arguments:
    step             Step size percentage (1-100, default: 5)
    percent          Brightness percentage (0-100)
EOF
}

# Detects which brightness control command to use.
#
# Checks backends in order: brightnessctl (backlight class only), ddcutil
# (external monitors), xbacklight. brightnessctl is tested with -c backlight
# to filter out LED devices which are not display brightness controls.
#
# Outputs:
#   Writes the detected command name to stdout.
#   Returns 0 if a command is found, 1 if no command is found.
detect_brightness_command() {
    if brightnessctl -c backlight info > /dev/null 2>&1; then
        echo "brightnessctl"
        return 0
    elif command -v ddcutil > /dev/null 2>&1 &&
        ddcutil detect --brief 2> /dev/null | grep -q '^Display [0-9]'; then
        echo "ddcutil"
        return 0
    elif command -v xbacklight > /dev/null 2>&1; then
        echo "xbacklight"
        return 0
    else
        echo "Error: No supported brightness control command found" >&2
        echo "Please install one of: brightnessctl, ddcutil, xbacklight" >&2
        return 1
    fi
}

# Check for required dependencies — at least one backend must be available.
check_dependencies() {
    if brightnessctl -c backlight info > /dev/null 2>&1; then
        return 0
    fi
    if command -v ddcutil > /dev/null 2>&1 &&
        ddcutil detect --brief 2> /dev/null | grep -q '^Display [0-9]'; then
        return 0
    fi
    if command -v xbacklight > /dev/null 2>&1; then
        return 0
    fi
    echo "Error: No supported brightness control command found" >&2
    echo "Please install one of: brightnessctl, ddcutil, xbacklight" >&2
    return 1
}

# Checks if another ddcutil instance is already running.
#
# Returns:
#   0 if no other instance is running, 1 if locked.
check_ddcutil_lock() {
    if pgrep -x ddcutil > /dev/null 2>&1; then
        echo "Error: Another ddcutil instance is running" >&2
        return 1
    fi
}

# Gets the current brightness level.
#
# Arguments:
#   $1 - The brightness command to use
#
# Outputs:
#   Writes current brightness level (0-100) to stdout.
get_brightness() {
    case "$1" in
        brightnessctl)
            echo $(($(brightnessctl -c backlight get) * 100 / $(brightnessctl -c backlight max)))
            ;;
        ddcutil)
            output=$(ddcutil getvcp --brief 10 2> /dev/null)
            cur=$(echo "$output" | awk '{print $4}')
            max=$(echo "$output" | awk '{print $5}')
            [ -z "$cur" ] || [ -z "$max" ] && return 1
            echo $((cur * 100 / max))
            ;;
        xbacklight)
            xbacklight -get | cut -d '.' -f 1
            ;;
    esac
}

# Gets the appropriate icon based on brightness level.
#
# Arguments:
#   $1 - Current brightness level (0-100)
#
# Outputs:
#   Writes path to appropriate icon to stdout.
get_icon() {
    BRIGHTNESS="$1"
    if [ "$BRIGHTNESS" -lt 40 ]; then
        echo "$ICON_LOW"
    elif [ "$BRIGHTNESS" -lt 70 ]; then
        echo "$ICON_MEDIUM"
    else
        echo "$ICON_HIGH"
    fi
}

# Sends a notification with the current brightness level.
#
# Arguments:
#   $1 - Current brightness level (0-100)
send_notification() {
    BRIGHTNESS="$1"
    ICON=$(get_icon "$BRIGHTNESS")
    notify-send -i "$ICON" -h int:value:"$BRIGHTNESS" -u low "Brightness [$BRIGHTNESS%]" --hint=string:x-dunst-stack-tag:brightness --hint=string:synchronous:brightness
}

# Changes brightness level.
#
# Arguments:
#   $1 - The brightness command to use
#   $2 - Operation to perform ("increase", "decrease", or "set")
#   $3 - Value (step size for increase/decrease, target percentage for set)
change_brightness() {
    BRIGHTNESS_CMD="$1"
    OPERATION="$2"
    VALUE="$3"

    case "$BRIGHTNESS_CMD" in
        brightnessctl)
            case "$OPERATION" in
                increase)
                    brightnessctl -c backlight set "+${VALUE}%"
                    ;;
                decrease)
                    brightnessctl -c backlight set "${VALUE}%-"
                    ;;
                set)
                    brightnessctl -c backlight set "${VALUE}%"
                    ;;
            esac
            ;;
        ddcutil)
            check_ddcutil_lock || return 1
            case "$OPERATION" in
                increase)
                    max=$(ddcutil getvcp --brief 10 2> /dev/null | awk '{print $5}')
                    raw_step=$((max * VALUE / 100))
                    ddcutil --noverify --sleep-multiplier 0.2 setvcp 10 + "$raw_step" > /dev/null 2>&1
                    ;;
                decrease)
                    max=$(ddcutil getvcp --brief 10 2> /dev/null | awk '{print $5}')
                    raw_step=$((max * VALUE / 100))
                    ddcutil --noverify --sleep-multiplier 0.2 setvcp 10 - "$raw_step" > /dev/null 2>&1
                    ;;
                set)
                    max=$(ddcutil getvcp --brief 10 2> /dev/null | awk '{print $5}')
                    raw=$((max * VALUE / 100))
                    ddcutil --noverify --sleep-multiplier 0.2 setvcp 10 "$raw" > /dev/null 2>&1
                    ;;
            esac
            ;;
        xbacklight)
            case "$OPERATION" in
                increase)
                    xbacklight -inc "$VALUE"
                    ;;
                decrease)
                    xbacklight -dec "$VALUE"
                    ;;
                set)
                    xbacklight -set "$VALUE"
                    ;;
            esac
            ;;
    esac

    send_notification "$(get_brightness "$BRIGHTNESS_CMD")"
}

# Main entry point that processes command-line arguments.
#
# Arguments:
#   $1 - Operation to perform
#   $2 - Optional value (step size or target percentage)
main() {
    check_dependencies

    case "$1" in
        increase | decrease)
            BRIGHTNESS_CMD=$(detect_brightness_command) || exit 1
            VALUE="${2:-5}"
            if [ "$VALUE" -gt 0 ] && [ "$VALUE" -le 100 ]; then
                change_brightness "$BRIGHTNESS_CMD" "$1" "$VALUE"
            else
                echo "Error: Step size must be between 1 and 100" >&2
                exit 1
            fi
            ;;
        set)
            BRIGHTNESS_CMD=$(detect_brightness_command) || exit 1
            if [ $# -eq 2 ]; then
                VALUE="$2"
                if [ "$VALUE" -ge 0 ] && [ "$VALUE" -le 100 ]; then
                    change_brightness "$BRIGHTNESS_CMD" "$1" "$VALUE"
                else
                    echo "Error: Percentage must be between 0 and 100" >&2
                    exit 1
                fi
            else
                echo "Error: Percentage required for set operation" >&2
                exit 1
            fi
            ;;
        get)
            BRIGHTNESS_CMD=$(detect_brightness_command) || exit 1
            get_brightness "$BRIGHTNESS_CMD"
            ;;
        -h | --help)
            usage
            ;;
        *)
            usage
            exit 1
            ;;
    esac
}

main "$@"
