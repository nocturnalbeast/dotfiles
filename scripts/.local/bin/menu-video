#!/usr/bin/env bash

# A video streaming, downloading, and queueing menu.

usage() {
    cat << EOF
Usage: $(basename "$0") [URL]

A video streaming, downloading, and queueing menu.

If URL is provided, prompts for action directly. Otherwise, prompts for
URL source (clipboard or search) and then action.

Arguments:
    URL    Video URL to process. If omitted, prompts for URL or search.

Operations:
    Stream              Stream video in mpv player.
    Open in browser     Open video in default browser.
    Download            Download video with quality selection.
    Queue audio         Queue audio in MPD/Mopidy player.
EOF
}

# Global configuration
DEPENDENCIES=(yt-dlp clipmenu mpc)
ED_ARGS="-c -j 3 -x 3 -s 3 -k 1M"
SEARCH_RESULT_NUM="5"
DEST_DIR="$XDG_VIDEOS_DIR/downloaded"
ICON="${XDG_CONFIG_HOME:="$HOME/.config"}/dunst/icons/video.svg"
URL_REGEX="(((http|magnet|https|ftp|gopher)|mailto):(//|\?)?[^ <>\"\t]*|(www|ftp)[0-9]?\\.[-a-z0-9.]+)[^ .,;\\n\r<\">\\):]?[^, <>\"\]*[^ .,;\\n\r<\">\\):]"

# Check for required dependencies
check_dependencies() {
    for DEPENDENCY in "${DEPENDENCIES[@]}"; do
        type -p "$DEPENDENCY" > /dev/null 2>&1 || {
            echo "error: Could not find '${DEPENDENCY}', is it installed?" >&2
            exit 1
        }
    done
}

# Extract URL from clipboard history.
#
# Outputs:
#   The selected URL from clipboard history
get_url_from_clipboard() {
    dmenu-helper run_menu " 輸 Select URL: " "$(clipmenu | grep -Eo "$URL_REGEX")"
}

# Search YouTube for a video and return URL.
#
# Arguments:
#   $1 - Search query term
#
# Outputs:
#   The selected video URL
search_video() {
    local SEARCH_QUERY="$1"
    local ID_ARR=()
    local TITLE_ARR=()

    while IFS=$'\n' read -r VID_TITLE; do
        IFS=$'\n' read -r VID_ID
        ID_ARR+=("$VID_ID")
        TITLE_ARR+=("$VID_TITLE")
    done <<< "$(yt-dlp --default-search ytsearch$SEARCH_RESULT_NUM "$SEARCH_QUERY" --get-id --get-title 2> /dev/null)"

    if [ "${ID_ARR[0]}" = "" ]; then
        notify-send "Failed to get search results for:" "$SEARCH_QUERY" -i "$ICON"
        exit 1
    fi

    local SEL_TITLE
    SEL_TITLE="$(dmenu-helper run_menu "  Search results: " "$(for IDX in "${!TITLE_ARR[@]}"; do echo "$((IDX + 1)):${TITLE_ARR[$IDX]}"; done)")"
    [ "$SEL_TITLE" = "" ] && exit 0

    echo "https://www.youtube.com/watch?v=${ID_ARR[$(($(echo "$SEL_TITLE" | cut -f 1 -d :) - 1))]}"
}

# Get video URL either from argument, clipboard, or search.
#
# Arguments:
#   $1 - Optional URL argument
#
# Outputs:
#   The video URL
get_video_url() {
    local URL=""

    if [ -z "$1" ]; then
        local MAIN_ACTION
        MAIN_ACTION="$(dmenu-helper run_menu " 輸 " " Use link from clipboard\n Search for a video")"
        [ "$MAIN_ACTION" = "" ] && exit 0

        case "$MAIN_ACTION" in
            ' Use link from clipboard')
                URL="$(get_url_from_clipboard)"
                ;;
            ' Search for a video')
                local SEARCH_QUERY
                SEARCH_QUERY="$(dmenu-helper run_menu "  Enter search term: " "")"
                [ "$SEARCH_QUERY" = "" ] && exit 0
                URL="$(search_video "$SEARCH_QUERY")"
                ;;
        esac
    else
        URL="$(echo "$1" | grep -Eo "$URL_REGEX")"
    fi

    echo "$URL"
}

# Stream video in mpv player.
#
# Arguments:
#   $1 - Video URL
#   $2 - Video name/title
stream_video() {
    local URL="$1"
    local VNAME="$2"

    notify-send "Opening video in player:" "$VNAME" -i "$ICON"
    mpv "$URL" &
}

# Open video in default browser.
#
# Arguments:
#   $1 - Video URL
#   $2 - Video name/title
open_in_browser() {
    local URL="$1"
    local VNAME="$2"

    notify-send "Opening video in browser:" "$VNAME" -i "$ICON"
    xdg-open "$URL" &
}

# Download video with quality selection.
#
# Arguments:
#   $1 - Video URL
#   $2 - Video name/title
download_video() {
    local URL="$1"
    local VNAME="$2"

    notify-send "Fetching available formats..." -i "$ICON"

    local AVAIL_FMTS
    AVAIL_FMTS="$(yt-dlp -F "$URL" | tail -n +4 | sed 's/audio only/audio/g; s/ \+/,/g' | tr -s ',' ':')"

    local QUALITY
    QUALITY="$(dmenu-helper run_menu " 輸 Select quality: " "$AVAIL_FMTS" | cut -f 1 -d :)"
    [ "$QUALITY" = "" ] && exit 0

    [ ! -d "$DEST_DIR" ] && mkdir -p "$DEST_DIR"

    if [ "$ED_ARGS" = "" ]; then
        yt-dlp -f "$QUALITY" -o "$DEST_DIR/%(title)s.%(ext)s" --external-downloader aria2c "$URL" &
    else
        yt-dlp -f "$QUALITY" -o "$DEST_DIR/%(title)s.%(ext)s" --external-downloader aria2c --external-downloader-args "$ED_ARGS" "$URL" &
    fi

    notify-send "Download completed:" "$VNAME" -i "$ICON"
}

# Queue audio in MPD/Mopidy player.
#
# Arguments:
#   $1 - Video URL
queue_audio() {
    local URL="$1"

    mpc add "yt:$URL"
    notify-send "Added audio to queue." -i "$ICON"

    local PN_CHOICE
    PN_CHOICE="$(dmenu-helper run_menu "  Play added song now? " "yes\nno")"
    [ "$PN_CHOICE" = "yes" ] && mpc play "$(mpc playlist | wc -l)"
}

# Main entry point
main() {
    check_dependencies

    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
    esac

    local URL
    URL="$(get_video_url "$1")"

    [ "$URL" = "" ] && exit 0

    local VNAME
    VNAME="$(yt-dlp -e "$URL")"

    local LINK_ACTION
    LINK_ACTION="$(dmenu-helper run_menu " 輸 What to do with this URL? " "契 Stream\n Open in browser\n Download\n Queue audio in player")"
    [ "$LINK_ACTION" = "" ] && exit 0

    case "$LINK_ACTION" in
        '契 Stream')
            stream_video "$URL" "$VNAME"
            ;;
        ' Open in browser')
            open_in_browser "$URL" "$VNAME"
            ;;
        ' Download')
            download_video "$URL" "$VNAME"
            ;;
        ' Queue audio in player')
            queue_audio "$URL"
            ;;
    esac
}

main "$@"
