#!/usr/bin/env bash

# A menu for window selection and management.
# Uses wmctl for compositor-agnostic window data.

DEPENDENCIES=(menu wmctl)

usage() {
    cat << EOF
Usage: $(basename "$0")

A menu for window selection and management.

This script displays a menu of available windows and allows you to focus on them.
EOF
}

check_dependencies() {
    for dependency in "${DEPENDENCIES[@]}"; do
        command -v "$dependency" > /dev/null 2>&1 || {
            echo "error: Could not find '${dependency}', is it installed?" >&2
            return 1
        }
    done
}

main() {
    check_dependencies || return 1

    local monitor_count entries selected addr
    monitor_count=$(wmctl monitor count)

    # Build menu entries from wmctl window list
    if [ "$monitor_count" -gt 1 ]; then
        entries=$(wmctl window list 2> /dev/null | jq -r \
            '.[] | "\(.address)\t\(.monitor // "?")\t\(.workspace.name // "—")\t\(.title)"')
    else
        entries=$(wmctl window list 2> /dev/null | jq -r \
            '.[] | "\(.address)\t\(.workspace.name // "—")\t\(.title)"')
    fi

    [ -z "$entries" ] && {
        echo "No windows found." >&2
        return 1
    }

    # Format for display: strip the address tab, show the rest
    if [ "$monitor_count" -gt 1 ]; then
        display=$(echo "$entries" | while IFS=$'\t' read -r _ mon ws title; do
            echo "[$mon - $ws] $title"
        done)
    else
        display=$(echo "$entries" | while IFS=$'\t' read -r _ ws title; do
            echo "[$ws] $title"
        done)
    fi

    selected=$(echo "$display" | menu run -p "  ")
    [ -z "$selected" ] && exit 0

    # Map selection back to window address
    local idx
    idx=$(echo "$display" | grep -nF "$selected" | head -1 | cut -d: -f1)
    addr=$(echo "$entries" | sed -n "${idx}p" | cut -f1)

    [ -n "$addr" ] && wmctl window focus "$addr"
}

main "$@"
