#!/usr/bin/env bash

# A menu for workspace selection and management.
# Uses wmctl for compositor-agnostic workspace data.

DEPENDENCIES=(menu wmctl)

usage() {
    cat << EOF
Usage: $(basename "$0")

A menu for workspace selection and management.

This script displays a menu of available workspaces and allows you to switch to them.
EOF
}

check_dependencies() {
    for dependency in "${DEPENDENCIES[@]}"; do
        command -v "$dependency" > /dev/null 2>&1 || {
            echo "error: Could not find '${dependency}', is it installed?" >&2
            return 1
        }
    done
}

main() {
    check_dependencies || return 1

    local monitor_count entries selected ws_id
    monitor_count=$(wmctl monitor count)

    # Build menu entries from wmctl workspace list
    if [ "$monitor_count" -gt 1 ]; then
        entries=$(wmctl workspace list 2> /dev/null | jq -r \
            '.[] | "\(.id)\t\(.monitor // "?")\t\(.name)"')
    else
        entries=$(wmctl workspace list 2> /dev/null | jq -r \
            '.[] | "\(.id)\t\(.name)"')
    fi

    [ -z "$entries" ] && {
        echo "No workspaces found." >&2
        return 1
    }

    # Format for display
    if [ "$monitor_count" -gt 1 ]; then
        display=$(echo "$entries" | while IFS=$'\t' read -r _ mon name; do
            echo "[$mon] $name"
        done)
    else
        display=$(echo "$entries" | while IFS=$'\t' read -r _ name; do
            echo "$name"
        done)
    fi

    selected=$(echo "$display" | menu run -p "  ")
    [ -z "$selected" ] && exit 0

    # Map selection back to workspace ID
    local idx
    idx=$(echo "$display" | grep -nF "$selected" | head -1 | cut -d: -f1)
    ws_id=$(echo "$entries" | sed -n "${idx}p" | cut -f1)

    [ -n "$ws_id" ] && wmctl workspace focus "$ws_id"
}

main "$@"
