#!/usr/bin/env sh

# A script to launch a terminal emulator with automatic detection and prioritization.
#
# Presents an xterm-compatible command surface for maximum compatibility with
# terminal-spawning tools (xterm's flags are the de-facto contract):
#
#   terminal                    launch the detected terminal
#   terminal -e CMD [ARGS...]   run CMD (xterm -e semantics: rest of argv)
#   terminal -T TITLE           set the window title
#   terminal -l                 print the backend lookup table
#   terminal -g                 print the detected terminal and exit
#
# Also translated (used by the scratchpad call site, not advertised):
#   terminal -class NAME        set WM_CLASS / app_id (xterm -class)
#
# Unknown leading arguments are passed through to the backend untranslated.

# Global configuration
# Terminals are listed in order of preference for each display server
WAYLAND_TERMINALS="\
foot \
kitty \
alacritty \
wezterm \
termite"

X11_TERMINALS="\
x-terminal-emulator \
mate-terminal \
gnome-terminal \
terminator \
xfce4-terminal \
urxvt \
rxvt \
xterm \
uxterm \
aterm \
Eterm \
roxterm \
lxterminal \
terminology \
st \
qterminal \
lilyterm \
tilix \
terminix \
konsole \
guake \
tilda \
hyper"

# Backends with a known translation (see print_lookup_table). Anything else
# falls back to raw argument passthrough.
TRANSLATED_BACKENDS="kitty alacritty foot wezterm xterm"

usage() {
    cat << EOF
Usage: $(basename "$0") [-T TITLE] [-class NAME] [-e COMMAND [ARGS...]]

A script to launch a terminal emulator with automatic detection.

Options:
    -T, --title TITLE    Set the window title
    -e, --execute        Execute the remainder of the command line instead of
                         the shell (xterm -e semantics)
    -l, --list           Print the backend flag-translation table and exit
    -g, --get            Print the detected terminal and exit
    -h, --help           Show this help

Detection order:
    1. \$TERMINAL environment variable if set and valid
    2. Parent terminal if script is run from a terminal
    3. First available terminal from display server specific list
       (Falls back to X11 terminals under Wayland if needed)
EOF
}

# Check for required dependencies
check_dependencies() {
    local terminals
    if is_wayland; then
        terminals="$WAYLAND_TERMINALS"
    else
        terminals="$X11_TERMINALS"
    fi
    local found=0
    for term in $terminals; do
        if command -v "$term" > /dev/null 2>&1; then
            found=1
            break
        fi
    done
    if [ "$found" -eq 0 ]; then
        echo "error: No terminal emulator found" >&2
        return 1
    fi
}

# Detects if running under Wayland.
#
# Returns:
#   0 if running under Wayland, 1 otherwise
is_wayland() {
    [ -n "$WAYLAND_DISPLAY" ]
}

# Gets the appropriate terminal list based on display server.
#
# Outputs:
#   Writes space-separated list of terminals to stdout.
get_terminal_list() {
    if is_wayland; then
        echo "$WAYLAND_TERMINALS"
    else
        echo "$X11_TERMINALS"
    fi
}

# Detects if a command exists and is executable.
#
# Arguments:
#   $1 - Command to check
#
# Returns:
#   0 if command exists and is executable, 1 otherwise
command_exists() {
    command -v "$1" > /dev/null 2>&1
}

# Gets the parent terminal if script is run from a terminal.
#
# Outputs:
#   Writes parent terminal name to stdout if found, empty string otherwise.
get_parent_terminal() {
    if [ -n "$TERM" ] && [ "$TERM" != "dumb" ]; then
        SHELL_PPID="$(ps -p "$PPID" -o ppid= | tr -d " ")"
        SHELL_PPNAME="$(ps -p "$SHELL_PPID" -o comm=)"
        # Check against all possible terminals
        if echo "$WAYLAND_TERMINALS $X11_TERMINALS" | grep -q "$SHELL_PPNAME" 2> /dev/null; then
            echo "$SHELL_PPNAME"
        fi
    fi
}

# Gets the first available terminal from a list.
#
# Arguments:
#   $1 - Space-separated list of terminals to check
#
# Outputs:
#   Writes first available terminal name to stdout if found, empty string otherwise.
get_first_available() {
    for terminal in $1; do
        if command_exists "$terminal"; then
            echo "$terminal"
            return 0
        fi
    done
    echo ""
}

# Gets the default terminal from gsettings.
#
# Outputs:
#   Writes default terminal name to stdout if found, empty string otherwise.
get_default_terminal() {
    # Guard: never resolve to ourselves (the DE schema may point at this
    # wrapper, e.g. via nemo's terminal wiring) - that would recurse forever.
    SELF_NAME=$(basename "$0")
    if command_exists "gsettings"; then
        terminal=$(gsettings get org.gnome.desktop.default-applications.terminal exec | tr -d "'")
        if [ -n "$terminal" ] && [ "$terminal" != "$SELF_NAME" ] && command_exists "$terminal"; then
            echo "$terminal"
            return 0
        fi
        terminal=$(gsettings get org.cinnamon.desktop.default-applications.terminal exec | tr -d "'")
        if [ -n "$terminal" ] && [ "$terminal" != "$SELF_NAME" ] && command_exists "$terminal"; then
            echo "$terminal"
            return 0
        fi
    elif [ -f "${XDG_CONFIG_HOME:-~/.config}/xfce4/helpers.rc" ]; then
        terminal=$(grep -E -o 'TerminalEmulator=\w+' "${XDG_CONFIG_HOME:-~/.config}/xfce4/helpers.rc" | head -1 | cut -d'=' -f2)
        if [ -n "$terminal" ] && [ "$terminal" != "$SELF_NAME" ] && command_exists "$terminal"; then
            echo "$terminal"
            return 0
        fi
    fi
    echo ""
}

# Detects which terminal to use based on priority.
#
# Outputs:
#   Writes selected terminal name to stdout.
#   Returns 0 if a terminal is found, 1 otherwise.
detect_terminal() {
    # Check $TERMINAL environment variable
    if [ -n "$TERMINAL" ] && command_exists "$TERMINAL"; then
        echo "Using \$TERMINAL: $TERMINAL" >&2
        echo "$TERMINAL"
        return 0
    fi

    # Check parent terminal
    PARENT_TERMINAL=$(get_parent_terminal)
    if [ -n "$PARENT_TERMINAL" ]; then
        echo "Using parent terminal: $PARENT_TERMINAL" >&2
        echo "$PARENT_TERMINAL"
        return 0
    fi

    # Check default terminal from DE settings
    DEFAULT_TERMINAL=$(get_default_terminal)
    if [ -n "$DEFAULT_TERMINAL" ]; then
        echo "Using default terminal: $DEFAULT_TERMINAL" >&2
        echo "$DEFAULT_TERMINAL"
        return 0
    fi

    # Get display server specific terminal list
    TERMINAL_LIST=$(get_terminal_list)

    # Check terminal list
    FOUND_TERMINAL=$(get_first_available "$TERMINAL_LIST")
    if [ -n "$FOUND_TERMINAL" ]; then
        if is_wayland; then
            echo "Using Wayland terminal: $FOUND_TERMINAL" >&2
        else
            echo "Using X11 terminal: $FOUND_TERMINAL" >&2
        fi
        echo "$FOUND_TERMINAL"
        return 0
    fi

    # If no Wayland terminal found under Wayland, try X11 terminals as fallback
    if is_wayland && [ -z "$FOUND_TERMINAL" ]; then
        FOUND_TERMINAL=$(get_first_available "$X11_TERMINALS")
        if [ -n "$FOUND_TERMINAL" ]; then
            echo "Using X11 terminal under Wayland: $FOUND_TERMINAL" >&2
            echo "$FOUND_TERMINAL"
            return 0
        fi
    fi

    echo "No terminal emulator found!" >&2
    return 1
}

# Prints the backend flag-translation table, one line per backend:
#   name:exec=<args>:title=<flag>:class=<flag>:cwd=<flag>:hold=<flag>
# Verified against upstream CLIs (kitty/alacritty/foot/wezterm/xterm,
# master + latest releases, 2026-10). Consumers (mimeapps, other tools)
# should parse this instead of hardcoding.
print_lookup_table() {
    cat << 'EOF'
kitty:exec=:title=-T:class=--class:cwd=-d:hold=--hold
alacritty:exec=-e:title=-T:class=--class:cwd=--working-directory:hold=--hold
foot:exec=:title=-T:class=--app-id:cwd=-D:hold=-H
wezterm:exec=start --:title=NONE:class=start --class:cwd=start --cwd:hold=NONE
xterm:exec=-e:title=-T:class=-class:cwd=NONE:hold=-hold
EOF
}

# Translates the xterm-style surface into backend-specific arguments and
# execs the backend. Flags are PREPENDED in reverse final order so that
# exec-style separators (-e / --) end up immediately before the command.
#
# Inputs (globals set by main):
#   TERM_TITLE   - title string or empty
#   TERM_CLASS   - class/app-id string or empty
#   TERM_HAS_CMD - 1 when -e was used (rest of argv is the command)
#   TERM_TAIL    - raw passthrough args preceding the command
#   TERM_ORIGINAL_ARGS - verbatim argv, used for unknown-backend passthrough
#
# Arguments:
#   $1 - detected backend name
#   $@ - command args (when TERM_HAS_CMD=1), else nothing
translate_and_exec() {
    TR_BACKEND=$1
    shift

    case " $TRANSLATED_BACKENDS " in
        *" $TR_BACKEND "*) ;;
        *)
            # Unknown backend: verbatim passthrough, preserve legacy behavior
            echo "$(basename "$0"): no translation for '$TR_BACKEND', passing arguments through as-is" >&2
            exec "$TR_BACKEND" $TERM_ORIGINAL_ARGS
            ;;
    esac

    # Merge passthrough args in front of the command
    set -- $TERM_TAIL "$@"

    # Exec separator first (must sit directly before the command)
    if [ "$TERM_HAS_CMD" = "1" ]; then
        case "$TR_BACKEND" in
            alacritty | xterm) set -- -e "$@" ;;
            wezterm) set -- -- "$@" ;;
        esac
        # kitty: command is positional; foot: trailing positionals (-e ignored)
    fi

    # Class flag
    if [ -n "$TERM_CLASS" ]; then
        case "$TR_BACKEND" in
            foot) set -- --app-id "$TERM_CLASS" "$@" ;;
            wezterm) set -- --class "$TERM_CLASS" "$@" ;;
            xterm) set -- -class "$TERM_CLASS" "$@" ;;
            *) set -- --class "$TERM_CLASS" "$@" ;;
        esac
    fi

    # wezterm needs the start subcommand before everything
    [ "$TR_BACKEND" = "wezterm" ] && set -- start "$@"

    # Title flag last (frontmost)
    if [ -n "$TERM_TITLE" ]; then
        case "$TR_BACKEND" in
            wezterm)
                echo "$(basename "$0"): wezterm has no title flag; dropping title '$TERM_TITLE'" >&2
                ;;
            *) set -- -T "$TERM_TITLE" "$@" ;;
        esac
    fi

    exec "$TR_BACKEND" "$@"
}

# Main entry point that processes command-line arguments.
#
# Arguments:
#   $@ - Options and command to run
main() {
    TERM_TITLE=""
    TERM_CLASS=""
    TERM_HAS_CMD=0
    TERM_TAIL=""
    TERM_ORIGINAL_ARGS="$*"

    while [ $# -gt 0 ]; do
        case $1 in
            "-h" | "--help")
                usage
                exit 0
                ;;
            "-l" | "--list")
                print_lookup_table
                exit 0
                ;;
            "-g" | "--get")
                SELECTED_TERMINAL=$(detect_terminal) || exit 1
                exit 0
                ;;
            "-T" | "--title")
                [ $# -ge 2 ] || {
                    echo "error: $1 requires an argument" >&2
                    exit 1
                }
                TERM_TITLE=$2
                shift
                ;;
            "-class" | "--class")
                [ $# -ge 2 ] || {
                    echo "error: $1 requires an argument" >&2
                    exit 1
                }
                TERM_CLASS=$2
                shift
                ;;
            "-e" | "--execute")
                shift
                TERM_HAS_CMD=1
                break
                ;;
            "--")
                shift
                while [ $# -gt 0 ]; do
                    TERM_TAIL="$TERM_TAIL $1"
                    shift
                done
                break
                ;;
            *)
                # Unrecognized argument: raw passthrough to the backend
                TERM_TAIL="$TERM_TAIL $1"
                ;;
        esac
        shift
    done

    check_dependencies || exit 1

    SELECTED_TERMINAL=$(detect_terminal) || exit 1
    translate_and_exec "$SELECTED_TERMINAL" "$@"
}

main "$@"
