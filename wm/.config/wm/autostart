#!/usr/bin/env sh

#          _           _           _
#  ___ _ _| |_ ___ ___| |_ ___ ___| |_
# | .'| | |  _| . |_ -|  _| .'|  _|  _|
# |__,|___|_| |___|___|_| |__,|_| |_|

is_wayland() {
    [ -n "$WAYLAND_DISPLAY" ]
}

# Kill any existing instance, then launch in the background.
# Usage: ensure_daemon <process_name> <command...>
ensure_daemon() {
    _name="$1"
    shift
    pkill -x "$_name" 2> /dev/null
    sleep 0.3
    "$@" &
}

# Only start if not already running. Does NOT restart.
# Usage: start_once <process_name> <command...>
start_once() {
    _name="$1"
    shift
    pgrep -x "$_name" > /dev/null 2>&1 && return 0
    "$@" &
}

if ! is_wayland; then
    # configure monitor layout and set dpi (for X11)
    layout_file="${XDG_CONFIG_HOME:-$HOME/.config}/wm/current_layout"
    if [ -f "$layout_file" ]; then
        "${XDG_CONFIG_HOME:-$HOME/.config}"/wm/layouts/"$(cat "$layout_file")" &
    fi
    dpi_script="${XDG_CONFIG_HOME:-$HOME/.config}/wm/set-dpi"
    if [ -f "$dpi_script" ]; then
        "$dpi_script"
    fi
else
    # run xsettingsd with the source path
    ensure_daemon xsettingsd xsettingsd --config "${XDG_CONFIG_HOME:-$HOME/.config}/wm/xsettingsd.conf"
fi

# restore the wallpaper
background restore

# start audio
if systemctl --user list-unit-files pipewire.service > /dev/null 2>&1; then
    if [ "$(systemctl --user is-active pipewire.service)" != "active" ]; then
        systemctl --user restart pipewire.service
    fi
elif command -v pipewire > /dev/null 2>&1; then
    if ! pgrep -x "pipewire" > /dev/null; then
        start_once pipewire pipewire
    fi
fi

# launch notification daemon
if command -v notificationd > /dev/null 2>&1; then
    start_once notificationd notificationd start
fi

# launch compositor for X11 WMs
if ! is_wayland; then
    ensure_daemon picom picom -b
fi

# launch clipboard manager
if command -v clipcatd > /dev/null 2>&1; then
    ensure_daemon clipcatd clipcatd
fi

# launch screen autolocker
if ! lockctl status > /dev/null 2>&1; then
    lockctl start
fi

# launch system bars
if command -v quickshell > /dev/null 2>&1; then
    ensure_daemon quickshell quickshell
elif ! is_wayland; then
    if command -v polybar polybarctl > /dev/null 2>&1; then
        polybarctl start
    fi
else
    if command -v waybar > /dev/null 2>&1; then
        ensure_daemon waybar waybar
    fi
fi

# networkmanager tray applet
if command -v nm-applet > /dev/null 2>&1; then
    ensure_daemon nm-applet nm-applet
fi

# bluetooth tray applet
if command -v blueman-applet > /dev/null 2>&1; then
    ensure_daemon blueman-applet blueman-applet
fi

# disk mounting tray applet
if command -v udiskie > /dev/null 2>&1; then
    ensure_daemon udiskie udiskie -Avnt
fi

# keyboard remapping
if command -v kanata-tray > /dev/null 2>&1; then
    export KANATA_TRAY_LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kanata-tray"
    mkdir -p "$KANATA_TRAY_LOG_DIR"
    ensure_daemon kanata-tray kanata-tray
fi

# set numlock key to off (X11 only)
if ! is_wayland && command -v numlockx > /dev/null 2>&1; then
    numlockx off &
fi

# mouse configuration for x11
if ! is_wayland; then
    # make sure the default root window uses the correct pointer
    xsetroot -cursor_name left_ptr
    # hide cursor when inactive
    ensure_daemon unclutter unclutter
fi

# launch music player server
music_started=false
if command -v owntonectl > /dev/null 2>&1 && owntonectl start; then
    music_started=true
fi
if [ "$music_started" = false ] && command -v mopidy > /dev/null 2>&1; then
    start_once mopidy mopidy
    sleep 2
    if pgrep -x mopidy > /dev/null 2>&1; then
        music_started=true
    fi
fi
if [ "$music_started" = false ] && command -v mpd > /dev/null 2>&1; then
    start_once mpd mpd
fi
