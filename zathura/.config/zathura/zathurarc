set font                        "Inter Display 12"

set default-fg                  "#7b7b7b"
set default-bg                  "#0a0a0a"

set statusbar-fg                "#808080"
set statusbar-bg                "#131313"

set inputbar-fg                 "#7b7b7b"
set inputbar-bg                 "#131313"

set notification-error-bg       "#0a0a0a"
set notification-error-fg       "#ffb3b2"
set notification-warning-bg     "#0a0a0a"
set notification-warning-fg     "#cbcb76"
set notification-bg             "#0a0a0a"
set notification-fg             "#7b7b7b"

set completion-bg               "#131313"
set completion-fg               "#7b7b7b"
set completion-group-bg         "#1b1b1b"
set completion-group-fg         "#0a0a0a"
set completion-highlight-bg     "#9ccbfb"
set completion-highlight-fg     "#0a0a0a"

set highlight-color             "#80d4d4"
set highlight-active-color      "#9ccbfb"

set index-bg                    "#0a0a0a"
set index-fg                    "#7b7b7b"
set index-active-bg             "#131313"
set index-active-fg             "#9ccbfb"

set recolor                     true
set recolor-keephue             true
set recolor-lightcolor          "#0a0a0a"
set recolor-darkcolor           "#7b7b7b"

set statusbar-v-padding         15
set statusbar-h-padding         45

set pages-per-row               1
set page-padding                1

set statusbar-basename          true
set adjust-open                 width
set selection-clipboard         clipboard
set render-loading              false
